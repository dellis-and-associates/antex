{
  "$description": "Antex Pest Solutions — Brand Foundations v2.0 · red/black identity from the ant-lockup logo (new-logo.webp). Import into Figma with the Tokens Studio plugin.",
  "color": {
    "ink": {
      "950": { "value": "#101010", "type": "color", "description": "Ant Black — footer, dark surfaces, headings. Matches the logo's ant and bar." },
      "900": { "value": "#1B1B1B", "type": "color", "description": "Charcoal — hero surface, dark cards" }
    },
    "red": {
      "600": { "value": "#E4342B", "type": "color", "description": "Antex Red — primary brand color. Wordmark, CTAs, links, icons." },
      "700": { "value": "#B9241C", "type": "color", "description": "Brick — hover/pressed states, text links on light, destructive" },
      "50":  { "value": "#FDECEA", "type": "color", "description": "Blush — tints, tags, icon wells" }
    },
    "paper": {
      "50": { "value": "#FAFAFA", "type": "color", "description": "Paper — page background (the logo lives on white)" },
      "200": { "value": "#ECECEC", "type": "color", "description": "Fog — cards, section wells, dividers" }
    },
    "basalt": { "700": { "value": "#3E3E3E", "type": "color", "description": "Basalt — body text on light" } },
    "white": { "value": "#FFFFFF", "type": "color" }
  },
  "font": {
    "display": { "value": "Bricolage Grotesque", "type": "fontFamilies", "description": "Headlines & wordmark. Weights: 700, 800." },
    "body": { "value": "Archivo", "type": "fontFamilies", "description": "Body, UI, buttons. Weights: 400, 500, 600." },
    "utility": { "value": "Space Mono", "type": "fontFamilies", "description": "Eyebrows, data labels, phone numbers. Uppercase, +8% tracking." }
  },
  "typeScale": {
    "display": { "value": { "fontFamily": "{font.display}", "fontWeight": "800", "fontSize": "64", "lineHeight": "66" }, "type": "typography" },
    "h2":      { "value": { "fontFamily": "{font.display}", "fontWeight": "700", "fontSize": "40", "lineHeight": "46" }, "type": "typography" },
    "h3":      { "value": { "fontFamily": "{font.body}",    "fontWeight": "600", "fontSize": "24", "lineHeight": "32" }, "type": "typography" },
    "body":    { "value": { "fontFamily": "{font.body}",    "fontWeight": "400", "fontSize": "17", "lineHeight": "28" }, "type": "typography" },
    "small":   { "value": { "fontFamily": "{font.body}",    "fontWeight": "400", "fontSize": "14", "lineHeight": "22" }, "type": "typography" },
    "eyebrow": { "value": { "fontFamily": "{font.utility}", "fontWeight": "400", "fontSize": "13", "lineHeight": "20", "letterSpacing": "8%", "textCase": "uppercase" }, "type": "typography" },
    "button":  { "value": { "fontFamily": "{font.body}",    "fontWeight": "600", "fontSize": "15", "lineHeight": "20" }, "type": "typography" }
  },
  "space": {
    "1": { "value": "4",  "type": "spacing" },
    "2": { "value": "8",  "type": "spacing" },
    "3": { "value": "12", "type": "spacing" },
    "4": { "value": "16", "type": "spacing" },
    "6": { "value": "24", "type": "spacing" },
    "8": { "value": "32", "type": "spacing" },
    "12": { "value": "48", "type": "spacing" },
    "16": { "value": "64", "type": "spacing" },
    "24": { "value": "96", "type": "spacing" }
  },
  "radius": {
    "sm": { "value": "6",   "type": "borderRadius" },
    "md": { "value": "12",  "type": "borderRadius" },
    "lg": { "value": "20",  "type": "borderRadius" },
    "pill": { "value": "999", "type": "borderRadius" }
  },
  "shadow": {
    "card": { "value": { "x": "0", "y": "10", "blur": "30", "spread": "-12", "color": "#10101026" }, "type": "boxShadow" }
  },
  "motif": {
    "perimeter": { "value": "1.5px dashed rgba(228,52,43,.4), dash 5 gap 7, round caps", "type": "other", "description": "Signature element: the treated-perimeter line. Used around the hero visual, guarantee badge, and section dividers." }
  }
}
