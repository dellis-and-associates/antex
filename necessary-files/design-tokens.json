    "h3":      { "value": { "fontFamily": "{font.body}",    "fontWeight": "600", "fontSize": "24", "lineHeight": "32" }, "type": "typography" },
    "body":    { "value": { "fontFamily": "{font.body}",    "fontWeight": "400", "fontSize": "17", "lineHeight": "28" }, "type": "typography" },
    "small":   { "value": { "fontFamily": "{font.body}",    "fontWeight": "400", "fontSize": "14", "lineHeight": "22" }, "type": "typography" },
    "eyebrow": { "value": { "fontFamily": "{font.utility}", "fontWeight": "400", "fontSize": "13", "lineHeight": "20", "letterSpacing": "8%", "textCase": "uppercase" }, "type": "typography" },
    "button":  { "value": { "fontFamily": "{font.body}",    "fontWeight": "600", "fontSize": "15", "lineHeight": "20" }, "type": "typography" }
  },
  "space": {
    "1": { "value": "4",  "type": "spacing" },
    "2": { "value": "8",  "type": "spacing" },
    "3": { "value": "12", "type": "spacing" },
    "4": { "value": "16", "type": "spacing" },
    "6": { "value": "24", "type": "spacing" },
    "8": { "value": "32", "type": "spacing" },
    "12": { "value": "48", "type": "spacing" },
    "16": { "value": "64", "type": "spacing" },
    "24": { "value": "96", "type": "spacing" }
  },
  "radius": {
    "sm": { "value": "6",   "type": "borderRadius" },
    "md": { "value": "12",  "type": "borderRadius" },
    "lg": { "value": "20",  "type": "borderRadius" },
    "pill": { "value": "999", "type": "borderRadius" }
  },
  "shadow": {
    "card": { "value": { "x": "0", "y": "10", "blur": "30", "spread": "-12", "color": "#0F1C1726" }, "type": "boxShadow" }
  },
  "motif": {
    "perimeter": { "value": "1.5px dashed rgba(31,106,71,.45), dash 5 gap 7, round caps", "type": "other", "description": "Signature element: the treated-perimeter line. Used around the hero visual, guarantee badge, and section dividers." }
