{
  "$description": "Antex Pest Solutions — Brand Foundations v1.0 · 'Hold the Perimeter'. Import into Figma with the Tokens Studio plugin.",
  "color": {
    "ink": { "950": { "value": "#0F1C17", "type": "color", "description": "Night Pine — footer, dark surfaces, headings" } },
    "pine": {
      "800": { "value": "#17402F", "type": "color", "description": "Deep Juniper — hero surface, dark cards" },
      "600": { "value": "#1F6A47", "type": "color", "description": "Juniper — primary brand color, links, icons" },
      "100": { "value": "#DCEDE2", "type": "color", "description": "Mist — tints, tags, icon wells" }
    },
    "sand": {
      "50": { "value": "#FAF6EE", "type": "color", "description": "Bone — page background" },
      "200": { "value": "#EFE7D7", "type": "color", "description": "Sandstone — cards, section wells, dividers" }
    },
    "clay": { "600": { "value": "#C2551E", "type": "color", "description": "Canyon Clay — CTAs and highlights ONLY. Never for large surfaces." } },
    "basalt": { "700": { "value": "#33413A", "type": "color", "description": "Basalt — body text on light" } },
    "white": { "value": "#FFFFFF", "type": "color" }
  },
  "font": {
    "display": { "value": "Bricolage Grotesque", "type": "fontFamilies", "description": "Headlines & wordmark. Weights: 700, 800." },
    "body": { "value": "Archivo", "type": "fontFamilies", "description": "Body, UI, buttons. Weights: 400, 500, 600." },
    "utility": { "value": "Space Mono", "type": "fontFamilies", "description": "Eyebrows, data labels, phone numbers. Uppercase, +8% tracking." }
  },
  "typeScale": {
    "display": { "value": { "fontFamily": "{font.display}", "fontWeight": "800", "fontSize": "64", "lineHeight": "66" }, "type": "typography" },
